---
import Base from '../layouts/Base.astro';
---
<Base title="Book a free consultation — Outside AI"><section class="page-intro shell"><p class="eyebrow">Let’s make a little room</p><h1>Your day.<br/><em>A little easier.</em></h1><p class="intro">Choose a preferred date and time for a free, 30-minute consultation. We’ll confirm the details with you by email.</p></section><section class="booking-layout shell"><div class="booking-info"><h2>Start with a conversation.</h2><p>You don’t need a polished plan. Just tell us what’s taking up your time or where you could use a helping hand.</p><ul><li>Talk through your business or everyday routines.</li><li>Explore what AI could make easier.</li><li>Get a clear idea of a useful next step.</li></ul><h3>No pressure. No obligation.</h3><p>This is a request for a preferred time, rather than a live availability calendar. Your consultation is booked once we confirm it with you.</p><a class="text-link" href="mailto:keith@outside-ai.com">Prefer to email? keith@outside-ai.com ↗</a></div><div class="booking-panel"><div class="calendar-header"><button id="prev-month" type="button" aria-label="Previous month">←</button><h2 id="month-label"></h2><button id="next-month" type="button" aria-label="Next month">→</button></div><div class="calendar-grid" id="calendar" role="group" aria-label="Choose a preferred consultation date"></div><p class="selection" id="selection" aria-live="polite">Choose a weekday above.</p><form id="consultation-form"><label for="time">Preferred time</label><select id="time" required><option value="">Choose a time</option><option>Morning (9 am–12 pm)</option><option>Afternoon (12 pm–5 pm)</option><option>Evening (5 pm–7 pm)</option></select><label for="timezone">Your time zone</label><input id="timezone" required maxlength="80" placeholder="e.g. Eastern Time"/><label for="name">Your name</label><input id="name" autocomplete="name" required maxlength="120"/><label for="email">Your email</label><input id="email" type="email" autocomplete="email" required maxlength="254"/><label for="interest">What could you use help with?</label><select id="interest"><option>Custom AI for my business</option><option>A personal AI assistant</option><option>A bit of both / Let’s explore</option></select><label for="notes">Anything you’d like us to know? <span class="fine">(Optional)</span></label><textarea id="notes" rows="3" maxlength="2000" placeholder="A task, a routine, or something on your mind…"></textarea><button type="submit" class="button">Request a free consultation ↗</button><p class="fine">Opens a prefilled email in your email app. Review and send it to complete your request.</p><p class="booking-status" id="booking-status" role="status"></p></form><noscript><p>Please email <a href="mailto:keith@outside-ai.com">keith@outside-ai.com</a> with your preferred date and time.</p></noscript></div></section><script>
const calendar=document.querySelector<HTMLDivElement>('#calendar')!;
const monthLabel=document.querySelector<HTMLHeadingElement>('#month-label')!;
const selection=document.querySelector<HTMLParagraphElement>('#selection')!;
const previous=document.querySelector<HTMLButtonElement>('#prev-month')!;
const next=document.querySelector<HTMLButtonElement>('#next-month')!;
const now=new Date();now.setHours(0,0,0,0);
let month=new Date(now.getFullYear(),now.getMonth(),1);
let selectedDate:Date|null=null;
document.querySelector<HTMLInputElement>('#timezone')!.value=Intl.DateTimeFormat().resolvedOptions().timeZone;
function renderCalendar(){
monthLabel.textContent=month.toLocaleDateString(undefined,{month:'long',year:'numeric'});
previous.disabled=month.getFullYear()===now.getFullYear()&&month.getMonth()===now.getMonth();
next.disabled=month>=new Date(now.getFullYear(),now.getMonth()+5,1);
calendar.replaceChildren();
['Su','Mo','Tu','We','Th','Fr','Sa'].forEach(day=>{const label=document.createElement('span');label.className='day-label';label.textContent=day;calendar.append(label);});
for(let i=0;i<month.getDay();i++)calendar.append(document.createElement('span'));
const count=new Date(month.getFullYear(),month.getMonth()+1,0).getDate();
for(let day=1;day<=count;day++){const date=new Date(month.getFullYear(),month.getMonth(),day);const button=document.createElement('button');button.type='button';button.className='calendar-day';button.textContent=String(day);button.disabled=date<=now||date.getDay()===0||date.getDay()===6;button.setAttribute('aria-label',date.toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric',year:'numeric'}));button.setAttribute('aria-pressed',String(selectedDate?.getTime()===date.getTime()));button.addEventListener('click',()=>{selectedDate=date;selection.textContent=date.toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric',year:'numeric'});renderCalendar();});calendar.append(button);}}
previous.addEventListener('click',()=>{month=new Date(month.getFullYear(),month.getMonth()-1,1);renderCalendar();});
next.addEventListener('click',()=>{month=new Date(month.getFullYear(),month.getMonth()+1,1);renderCalendar();});renderCalendar();
document.querySelector<HTMLFormElement>('#consultation-form')!.addEventListener('submit',event=>{event.preventDefault();const status=document.querySelector<HTMLParagraphElement>('#booking-status')!;if(!selectedDate){status.textContent='Please choose a preferred date above.';calendar.querySelector<HTMLButtonElement>('button:not([disabled])')?.focus();return;}const value=(id:string)=>(document.getElementById(id) as HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement).value.trim();const date=selectedDate.toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric',year:'numeric'});const body=`Hi Keith,\n\nI’d like to request a free consultation.\n\nName: ${value('name')}\nEmail: ${value('email')}\nPreferred date: ${date}\nPreferred time: ${value('time')}\nTime zone: ${value('timezone')}\nInterested in: ${value('interest')}\n\n${value('notes')}\n\nPlease confirm whether this time works. Thank you!`;window.location.href=`mailto:keith@outside-ai.com?subject=${encodeURIComponent('Free consultation request — Outside AI')}&body=${encodeURIComponent(body)}`;status.textContent='Your email draft is ready. Send it from your email app; we’ll reply to confirm. If no app opened, email keith@outside-ai.com directly.';});
</script></Base>
