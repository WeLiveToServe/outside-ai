---
import '../styles/global.css';
const {title='Outside AI — AI for the rest of us.',description='Affordable custom AI for your business. Always-on personal assistants for your life. Built around the systems you already use.'}=Astro.props;
const path=Astro.url.pathname;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={`https://outside-ai.com${path}`}/><meta name="theme-color" content="#173d35"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body><a class="skip" href="#main">Skip to content</a><header class="shell header"><a class="brand" href="/" aria-label="Outside AI home"><span class="wordmark"><img src="/brand/outside-ai-logo-desktop-transparent.png" alt="Outside AI" width="1100" height="260"/></span><span class="byline">AI for the rest of us.</span></a><nav aria-label="Main navigation"><a href="/services/" aria-current={path.startsWith('/services')?'page':undefined}>Services</a><a href="/testimonials/" aria-current={path.startsWith('/testimonials')?'page':undefined}>Testimonials</a><a href="mailto:keith@outside-ai.com">Email us ↗</a><a class="button small" href="/consultation/">Let’s talk ↗</a></nav></header><main id="main"><slot/></main><section class="shell contact-band"><div><p class="eyebrow">A good place to start</p><h2>What would you like<br/>off your plate?</h2><p>Tell us what takes too much time. We’ll explore what AI can do.</p></div><div class="contact-actions"><a class="button" href="/consultation/">Book a free consultation ↗</a><a class="text-link" href="mailto:keith@outside-ai.com">Or email keith@outside-ai.com ↗</a><span class="fine">A conversation. No pressure. No obligation.</span></div></section><footer class="shell footer"><div><strong>Outside AI</strong><span>AI for the rest of us.</span></div><p>Built around your business. And your life.</p><span>© {new Date().getFullYear()} Outside AI</span></footer></body></html>
